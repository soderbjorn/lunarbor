{
  "name": "treefacts-electron",
  "productName": "TreeFacts",
  "version": "0.1.0",
  "description": "Electron desktop wrapper for the TreeFacts web app",
  "main": "main.js",
  "private": true,
  "scripts": {
    "prestart": "node scripts/dev-brand.js",
    "start": "electron .",
    "brand:dev": "node scripts/dev-brand.js",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "se.soderbjorn.treefacts",
    "productName": "TreeFacts",
    "copyright": "Copyright © 2026 Robert Söderbjörn",
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "resources/web/**/*",
      "resources/main/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "identity": null
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    }
  }
}
